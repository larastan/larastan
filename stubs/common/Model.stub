<?php

namespace Illuminate\Database\Eloquent;

/**
 * @implements \ArrayAccess<string, mixed>
 */
abstract class Model implements \JsonSerializable, \ArrayAccess
{
    /**
     * @var array<string, mixed>
     */
    protected $attributes = [];

    /**
     * @var array<string, string>
     */
    protected $casts = [];

    /**
     * @var list<string>
     */
    protected $hidden = [];

    /**
     * @var list<string>
     */
    protected $fillable = [];

    /**
     * @var list<string>
     */
    protected $visible = [];

    /**
     * @var list<string>
     */
    protected $appends = [];

    /**
     * @var list<string>
     */
    protected $with = [];

    /**
     * @var list<string>
     */
    protected $withCount = [];

    /**
     * Update the model in the database.
     *
     * @param  array{touch?: bool|null}  $options
     * @return bool
     */
    public function save(array $options = []);

    /**
     * Update the model in the database.
     *
     * @param  array<model-property<static>, mixed>  $attributes
     * @param  array<int|string, mixed>  $options
     * @return bool
     */
    public function update(array $attributes = [], array $options = []);

    /** @return builder-of<static> */
    public static function query();

    /** @return builder-of<static> */
    public function newQuery();

    /** @return builder-of<static> */
    public function newModelQuery();

    /** @return builder-of<static> */
    public function newQueryWithoutRelationships();

    /** @return builder-of<static> */
    public function newQueryWithoutScopes();

    /**
     * @param \Illuminate\Database\Eloquent\Scope|string $scope
     * @return builder-of<static>
     */
    public function newQueryWithoutScope($scope);

    /**
     * @param array<mixed>|int|string $ids
     * @return builder-of<static>
     */
    public function newQueryForRestoration($ids);

    /**
     * Begin querying a model with eager loading.
     *
     * @template TRelation of string
     * @param  string|array<int|TRelation, (\Closure(relation-of<static, TRelation>): mixed)|string|array<int|string, string>>  $relations
     * @return builder-of<static>
     */
    public static function with($relations);

    /**
     * Add a relationship aggregate subquery.
     *
     * @template TRelation of string
     * @param string|array<int|TRelation, (callable(aggregate-builder-of<static, TRelation>): mixed)|string> $relations
     * @param \Illuminate\Contracts\Database\Query\Expression|string $column
     * @param string|null $function
     * @return $this
     */
    public function loadAggregate($relations, $column, $function = null);

    /**
     * Count related records.
     *
     * @template TRelation of string
     * @param string|array<int|TRelation, (callable(aggregate-builder-of<static, TRelation>): mixed)|string> $relations
     * @return $this
     */
    public function loadCount($relations);

    /**
     * Select the maximum related column value.
     *
     * @template TRelation of string
     * @param string|array<int|TRelation, (callable(aggregate-builder-of<static, TRelation>): mixed)|string> $relations
     * @param \Illuminate\Contracts\Database\Query\Expression|string $column
     * @return $this
     */
    public function loadMax($relations, $column);

    /**
     * Select the minimum related column value.
     *
     * @template TRelation of string
     * @param string|array<int|TRelation, (callable(aggregate-builder-of<static, TRelation>): mixed)|string> $relations
     * @param \Illuminate\Contracts\Database\Query\Expression|string $column
     * @return $this
     */
    public function loadMin($relations, $column);

    /**
     * Sum a related column.
     *
     * @template TRelation of string
     * @param string|array<int|TRelation, (callable(aggregate-builder-of<static, TRelation>): mixed)|string> $relations
     * @param \Illuminate\Contracts\Database\Query\Expression|string $column
     * @return $this
     */
    public function loadSum($relations, $column);

    /**
     * Average a related column.
     *
     * @template TRelation of string
     * @param string|array<int|TRelation, (callable(aggregate-builder-of<static, TRelation>): mixed)|string> $relations
     * @param \Illuminate\Contracts\Database\Query\Expression|string $column
     * @return $this
     */
    public function loadAvg($relations, $column);

    /**
     * Select whether related records exist.
     *
     * @template TRelation of string
     * @param string|array<int|TRelation, (callable(aggregate-builder-of<static, TRelation>): mixed)|string> $relations
     * @return $this
     */
    public function loadExists($relations);

    /**
     * Eager load relations on the model.
     *
     * @template TRelation of string
     * @param  string|array<int|TRelation, (\Closure(relation-of<static, TRelation>): mixed)|string|array<int|string, string>>  $relations
     * @return $this
     */
    public function load($relations);

    /**
     * Eager load relations on the model if they are not already eager loaded.
     *
     * @template TRelation of string
     * @param  string|array<int|TRelation, (\Closure(relation-of<static, TRelation>): mixed)|string|array<int|string, string>>  $relations
     * @return $this
     */
    public function loadMissing($relations);
}

/**
 * @template TModel of Model
 */
class ModelNotFoundException extends \RuntimeException {}
