<?php

namespace Illuminate\Database\Eloquent;

use Illuminate\Contracts\Queue\QueueableCollection;
use Illuminate\Support\Collection as BaseCollection;

/**
 * @template TKey of array-key
 * @template TModel of \Illuminate\Database\Eloquent\Model
 *
 * @extends \Illuminate\Support\Collection<TKey, TModel>
 */
class Collection extends BaseCollection implements QueueableCollection
{
    /**
     * Get the Eloquent query builder from the collection.
     *
     * @return builder-of<TModel>
     */
    public function toQuery();

    /**
     * Load a set of relationships onto the collection.
     *
     * @template TRelation of string
     * @param  string|array<int|TRelation, (callable(relation-of<TModel, TRelation>): mixed)|string|array<int|string, string>>  $relations
     * @return $this
     */
    public function load($relations);

    /**
     * Load a set of relationships onto the collection if they are not already eager loaded.
     *
     * @template TRelation of string
     * @param  string|array<int|TRelation, (callable(relation-of<TModel, TRelation>): mixed)|string|array<int|string, string>>  $relations
     * @return $this
     */
    public function loadMissing($relations);

    /**
     * Find a model in the collection by key.
     *
     * @template TFindDefault
     *
     * @param  mixed  $key
     * @param  TFindDefault  $default
     * @phpstan-return ($key is \Illuminate\Database\Eloquent\Model ? TModel|TFindDefault : ($key is (\Illuminate\Contracts\Support\Arrayable<array-key, mixed>|array<mixed>) ? static<TKey, TModel> : TModel|TFindDefault))
     */
    public function find($key, $default = null);

    /**
     * Merge the collection with the given items.
     * Integer keys are renumbered, see \Illuminate\Support\Collection::shift().
     *
     * @param  iterable<array-key, TModel>  $items
     * @return static<(array<TKey, mixed> is array<int, mixed> ? int : TKey), TModel>
     */
    public function merge($items);
}
