<?php

namespace Illuminate\Database\Eloquent;

/**
 * @template TModel of \Illuminate\Database\Eloquent\Model
 */
interface Scope
{
    /**
     * @param \Illuminate\Database\Eloquent\Builder<TModel> $builder
     * @param TModel $model
     * @return void
     */
    public function apply(Builder $builder, Model $model);
}
