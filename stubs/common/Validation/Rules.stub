/**
 * @template-covariant TValue = \DateTimeInterface|float|int|string
 */
class Date
{
}

/**
 * @template-covariant TEnum of string = string
 */
class Enum
{
}

/**
 * @template-covariant TValues of array = array
 */
class In
{
}

/**
 * @template-covariant TValue = float|int|numeric-string
 */
class Numeric
{
    /**
     * @return self<__benevolent<int|numeric-string>>
     */
    public function digits(int $length);

    /**
     * @return self<__benevolent<int|numeric-string>>
     */
    public function digitsBetween(int $min, int $max);

    /**
     * @return self<__benevolent<int|numeric-string>>
     */
    public function exactly(int $value);

    /**
     * @template TStrict of bool = false
     * @param TStrict $strict
     * @return (TStrict is false ? self<__benevolent<int|numeric-string>> : self<int>)
     */
    public function integer(bool $strict = false);
}

