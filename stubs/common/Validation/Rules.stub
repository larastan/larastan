<?php

namespace Illuminate\Validation\Rules;

/** @template TCondition = mixed */
class ExcludeIf
{
}

/** @template TCondition = mixed */
class ExcludeUnless
{
}

/** @template TCondition = mixed */
class RequiredIf
{
}

/** @template TCondition = mixed */
class RequiredUnless
{
}

/**
 * @template-covariant TKeys of array = array
 */
class ArrayRule
{
}

/**
 * @template-covariant TValue = \DateTimeInterface|float|int|string
 */
class Date
{
}

/**
 * @template-covariant TEnum of string = string
 */
class Enum
{
}

/**
 * @template-covariant TValues of array = array
 */
class In
{
}

/**
 * @template-covariant TValue = float|int|numeric-string
 */
class Numeric
{
    /**
     * @return self<__benevolent<int|numeric-string>>
     */
    public function digits(int $length);

    /**
     * @return self<__benevolent<int|numeric-string>>
     */
    public function digitsBetween(int $min, int $max);

    /**
     * @return self<__benevolent<int|numeric-string>>
     */
    public function exactly(int $value);

    /**
     * @template TStrict of bool = false
     * @param TStrict $strict
     * @return (TStrict is false ? self<__benevolent<int|numeric-string>> : self<int>)
     */
    public function integer(bool $strict = false);
}

namespace Illuminate\Validation;

/**
 * @template TCondition = mixed
 * @template TRules = mixed
 * @template TDefaultRules = mixed
 */
class ConditionalRules
{
}

class Rule
{
    /**
     * @param \Illuminate\Contracts\Support\Arrayable<array-key, mixed>|array<array-key, mixed>|null $keys
     * @return \Illuminate\Validation\Rules\ArrayRule
     */
    public static function array($keys = null);

    /**
     * @template TEnum of \UnitEnum
     * @param class-string<TEnum> $type
     * @return \Illuminate\Validation\Rules\Enum<class-string<TEnum>>
     */
    public static function enum($type);

    /**
     * @return \Illuminate\Validation\Rules\Date<\DateTimeInterface|float|int|string>
     */
    public static function date();

    /**
     * @return \Illuminate\Validation\Rules\Date<float|int|string>
     */
    public static function dateTime();

    /**
     * @return \Illuminate\Validation\Rules\Numeric<__benevolent<float|int|numeric-string>>
     */
    public static function numeric();

    /**
     * @return \Illuminate\Validation\Rules\StringRule<string>
     */
    public static function string();
}
