<?php

namespace Illuminate\Database\Eloquent\Relations;

use Illuminate\Database\Eloquent\Builder;

/**
 * @template TRelatedModel of \Illuminate\Database\Eloquent\Model
 * @template TDeclaringModel of \Illuminate\Database\Eloquent\Model
 * @template TResult
 */
abstract class Relation
{
    /**
     * Execute the query as a "select" statement.
     *
     * @param array<int, model-property<TRelatedModel>> $columns
     * @return collection-of<TRelatedModel>
     */
    public function get($columns = ['*']);

    /**
     * Execute the query and get the first result if it's the sole matching record.
     *
     * @param  array<model-property<TRelatedModel>>|model-property<TRelatedModel>  $columns
     * @return TRelatedModel
     *
     * @throws \Illuminate\Database\Eloquent\ModelNotFoundException<TRelatedModel>
     * @throws \Illuminate\Database\MultipleRecordsFoundException
     */
    public function sole($columns = ['*']);

    /**
     * Add the constraints for an internal relationship existence query.
     *
     * Essentially, these queries compare on column names like whereColumn.
     *
     * @param  builder-of<TRelatedModel>  $query
     * @param  builder-of<TDeclaringModel>  $parentQuery
     * @param  array<model-property<TRelatedModel>>|model-property<TRelatedModel>  $columns
     * @return builder-of<TRelatedModel>
     */
    public function getRelationExistenceQuery(Builder $query, Builder $parentQuery, $columns = ['*']);

    /**
     * Get the underlying query for the relation.
     *
     * @return builder-of<TRelatedModel>
     */
    public function getQuery();
}
