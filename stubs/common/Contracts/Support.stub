<?php

namespace Illuminate\Contracts\Support;

interface Htmlable
{}

/**
 * @template-covariant TReturn of array = array<array-key, mixed>
 */
interface Arrayable
{
    /**
     * Get the instance as an array.
     *
     * @return TReturn
     */
    public function toArray();
}

interface Jsonable
{}

interface CanBeEscapedWhenCastToString
{}
