<?php

namespace Illuminate\Events;

class Dispatcher
{
    /**
     * @param string|object $event
     * @param mixed $payload
     * @return mixed
     */
    public function until($event, $payload = []);

    /**
     * @param string|object $event
     * @param mixed $payload
     * @param bool $halt
     * @return ($halt is true ? mixed : list<mixed>|null)
     */
    public function dispatch($event, $payload = [], $halt = false);
}
